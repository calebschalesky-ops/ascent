+        if (dot(unit(b.pos), [0, 0, 1]) > Math.cos(0.3)) inNose++;
+      }
+    }
+    expect(dMax).toBeLessThan(120 * 1.3); // it stays in its guns' reach …
+    expect(dMin).toBeGreaterThan(20); // … without ramming
